# All four are optional, but at least one must be set. If more than one is
# set, the server tries them in this order and only moves to the next if the
# current one is unavailable or fails (e.g. rate limited) — this stacks their
# free daily limits together instead of relying on just one.

# 1) OpenRouter — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# 2) Groq — get a free key (no card) at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# 3) Cerebras — get a free key (no card) at https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# 4) Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Railway sets PORT automatically; this is only used for local dev
PORT=3000
